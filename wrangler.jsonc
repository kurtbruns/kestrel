{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kestrel",
  "main": "src/index.ts",
  // Capped at the newest date the Vitest pool's bundled workerd supports; bump
  // when @cloudflare/vitest-pool-workers ships a newer runtime.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Bundle the operator setup guide (docs/setup/*.md) into the Worker as Text
  // modules, so the in-app Docs surface serves the repo markdown verbatim
  // (source of truth) without a separate build step. Applies to bundling under
  // wrangler dev/deploy AND the Vitest pool.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // ---------------------------------------------------------------------------
  // Top-level config == the DEVELOPMENT environment (used by `wrangler dev` and
  // the Vitest pool). Its mail transport is the in-memory `fake` adapter, so dev
  // can never reach a real inbox. Named environments below (staging/production)
  // must REDECLARE bindings and vars — wrangler does not inherit them.
  // Placeholder ids/domains are filled per-deployment; this is a generic template.
  // ---------------------------------------------------------------------------

  "triggers": { "crons": ["* * * * *"] },

  // Editor SPA served from ./public (the admin app lives under /admin). Unmatched
  // requests fall through to the Worker so the API/reader routes still run.
  "assets": { "directory": "./public", "not_found_handling": "none" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kestrel-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kestrel-media-dev" }],

  // Self-contained by default: ARCHIVE_ORIGIN defaults to APP_ORIGIN and
  // MEDIA_PUBLIC_BASE to `${APP_ORIGIN}/media`, both resolved in getConfig, so
  // they're omitted here. Set them only to opt into an apex archive or a media
  // custom domain (see production below). ARCHIVE_BASE_PATH drives both the
  // archive URL and the route that serves it.
  "vars": {
    "PROVIDER": "fake",
    "APP_ORIGIN": "http://localhost:8787",
    "ARCHIVE_BASE_PATH": "/newsletter",
    "SENDING_DOMAIN": "news.example.com",
    "FROM_ADDRESS": "Newsletter <newsletter@news.example.com>",
    "AWS_REGION": "us-east-1"
  },

  "env": {
    "staging": {
      "name": "kestrel-staging",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kestrel-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kestrel-media-staging" }],
      // Fully self-contained: archives and media serve on the app's own origin
      // (ARCHIVE_ORIGIN / MEDIA_PUBLIC_BASE default to it), no extra domains.
      "vars": {
        "PROVIDER": "ses",
        "APP_ORIGIN": "https://newsletter-staging.example.com",
        "ARCHIVE_BASE_PATH": "/newsletter",
        "SENDING_DOMAIN": "news.example.com",
        "FROM_ADDRESS": "Newsletter <newsletter@news.example.com>",
        "AWS_REGION": "us-east-1"
      }
    },

    "production": {
      "name": "kestrel-production",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kestrel-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kestrel-media-production" }],
      // Shows both optional enhancements (SPEC §10). Drop ARCHIVE_ORIGIN and
      // MEDIA_PUBLIC_BASE to stay self-contained like staging.
      //   ARCHIVE_ORIGIN: surface the archive on the website apex — only if that
      //     apex is a Cloudflare zone routing <APP_ORIGIN base path>/* to this Worker.
      //   MEDIA_PUBLIC_BASE: serve images from a media. custom domain instead of
      //     the Worker's own /media route.
      "vars": {
        "PROVIDER": "ses",
        "APP_ORIGIN": "https://newsletter.example.com",
        "ARCHIVE_ORIGIN": "https://example.com",
        "ARCHIVE_BASE_PATH": "/newsletter",
        "MEDIA_PUBLIC_BASE": "https://media.example.com",
        "SENDING_DOMAIN": "news.example.com",
        "FROM_ADDRESS": "Newsletter <newsletter@news.example.com>",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
