# Copy to `.dev.vars` (gitignored) for local development.
# For deployed environments, set these with `wrangler secret put <NAME> --env <env>`.

# --- Admin API auth ---
# Local dev authenticates with a JWT signed by DEV_AUTH_SECRET (the app verifies it
# via the same "verify token -> principal" contract Cloudflare Access uses in prod).
# The editor mints its own token from this on load — no other setup. It ships here
# rather than in wrangler.jsonc on purpose: a deployed env never gets this value, so
# the dev auth path stays fail-closed. In staging/production leave it unset; Access
# is the only gate.
DEV_AUTH_SECRET="dev-insecure-do-not-deploy"

# --- Cloudflare Access (JWT validation; the deployed gate — optional locally) ---
ACCESS_TEAM_DOMAIN=""       # e.g. your-team.cloudflareaccess.com
ACCESS_AUD=""               # the Access application's AUD tag
ACCESS_ALLOWED_EMAILS=""    # optional CSV allowlist of human admin emails, e.g. you@example.com

# --- Amazon SES (SigV4 over HTTPS via aws4fetch) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET=""   # config set that publishes bounce/complaint to SNS
SNS_TOPIC_ARN=""           # expected topic ARN, checked on webhook verification

# --- Resend (alternate transport) ---
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""   # Svix signing secret for webhook verification
