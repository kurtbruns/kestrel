# Copy to `.dev.vars` (gitignored) for local development.
# For deployed environments, set these with `wrangler secret put <NAME> --env <env>`.

# --- Admin API auth ---
# Local dev authenticates with a JWT signed by DEV_AUTH_SECRET (the app verifies it
# via the same "verify token -> principal" contract Cloudflare Access uses in prod).
# The editor mints its own token from this on load — no other setup. It ships here
# rather than in wrangler.jsonc on purpose: a deployed env never gets this value, so
# the dev auth path stays fail-closed. In staging/production leave it unset; Access
# is the only gate.
DEV_AUTH_SECRET="dev-insecure-do-not-deploy"

# --- Cloudflare Access (JWT validation; the deployed gate — optional locally) ---
ACCESS_TEAM_DOMAIN=""       # e.g. your-team.cloudflareaccess.com
ACCESS_AUD=""               # the Access application's AUD tag
ACCESS_ALLOWED_EMAILS=""    # optional CSV allowlist of human admin emails, e.g. you@example.com

# --- Amazon SES (SigV4 over HTTPS via aws4fetch) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET=""   # config set that publishes bounce/complaint to SNS
SNS_TOPIC_ARN=""           # the topic the SES webhook accepts; every other topic is refused

# --- Resend (alternate transport) ---
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""   # Svix signing secret for webhook verification

# --- Minimum lead ---
# How long every send stays visible and cancelable before it fires (docs/SPEC.md §6).
# Deployed environments default to 300 (five minutes); local dev uses the one-minute floor
# that every environment shares, so a send scheduled a minute out behaves exactly as it
# would deployed. Not a secret: a deployed environment sets it in its `vars` in
# wrangler.jsonc. Below 60 or above 86400 (one day) is refused.
MIN_LEAD_SECONDS="60"

# --- Dev send simulation (optional; local only) ---
# Swap the instant `fake` transport for a seeded simulation that paces a send over real
# time and produces a believable outcome mix (transient retries, a rate-limit pause on a
# large send, a few transport failures, plus delayed delivered/bounced/complained
# webhooks), so the in-flight watch view (#/sent/:id of a `sending` send) is actually
# watchable. Off by default; only honored in a dev-shaped env (fake transport, no
# Access, APP_ORIGIN on localhost), never deployed. Uncomment to enable, then restart
# `npm run dev`.
# SIMULATE_SENDS="1"
