# Client config for connecting a client (e.g. Claude Code) to a DEPLOYED Kestrel
# instance. Copy to `.kestrel.env` (gitignored) and fill in.
#
# This is NOT local-dev Worker config — that's `.dev.vars`, which the Worker reads.
# These values are presented by the client to Cloudflare Access; the Worker never
# reads them. The file lives on your machine but points at your deployed instance.
#
# Load into your shell:  set -a; source .kestrel.env; set +a

KESTREL_URL="https://newsletter.example.com"   # your deployed instance's base URL

# Cloudflare Access service token (Access → Service Auth). The secret is shown once.
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""
